# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=college_sports_day
DB_PORT=3306

# Auth — generate a long random string for JWT_SECRET
JWT_SECRET=replace_with_a_long_random_secret
ADMIN_USERNAME=adminpower
ADMIN_PASSWORD=replace_with_your_admin_password

# CORS — set to your Vercel frontend URL in production
FRONTEND_URL=https://your-app.vercel.app

# Cloudinary — from your Cloudinary dashboard (Account > API Keys)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Server
PORT=5000
NODE_ENV=development
